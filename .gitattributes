# Flutter-generated platform scaffolding is not application source.
# Keep it available for builds, but exclude it from GitHub language statistics.
android/** linguist-vendored=true linguist-generated=true
ios/** linguist-vendored=true linguist-generated=true
linux/** linguist-vendored=true linguist-generated=true
macos/** linguist-vendored=true linguist-generated=true
windows/** linguist-vendored=true linguist-generated=true
web/** linguist-vendored=true linguist-generated=true

# Application logic and tests remain counted as Dart.
*.dart linguist-detectable=true
